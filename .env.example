# Configuración de la base de datos (Ejemplo)
DB_URL=jdbc:mysql://localhost:3306/tu_base_de_datos
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña

# OpenAI Configuration (Ejemplo)
OPENAI_API_KEY=tu_openai_api_key_aca

# Twilio Configuration (Ejemplo)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid_aca
TWILIO_AUTH_TOKEN=tu_twilio_auth_token_aca
TWILIO_PHONE_NUMBER=tu_numero_telefono_twilio
TWILIO_WHATSAPP_NUMBER=tu_numero_whatsapp_twilio

# Modo desarrollo
APP_SMS_ENABLED=true
